# LLM: cualquier endpoint compatible con OpenAI (Groq, Gemini, OpenRouter u Ollama local).
# Cambiar de proveedor solo cambia estas tres variables.
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=  (vacío: usa la cadena de tremor/llm.py, Groq + todos los Gemini gratis)
LLM_API_KEY=

# Alertas por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gemini (respaldo cuando Groq agota su cupo; clave propia de Tremor, aistudio.google.com)
GEMINI_API_KEY=
# Tiempo de viaje de los tramos de la ruta (tráfico en vivo; developer.tomtom.com, sin tarjeta)
TOMTOM_API_KEY=

# Avisos por Telegram (tremor/avisos.py). Bot creado con @BotFather; el chat es el grupo o canal de avisos
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
