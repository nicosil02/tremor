# LLM: cualquier endpoint compatible con OpenAI (Groq, Gemini, OpenRouter u Ollama local).
# Cambiar de proveedor solo cambia estas tres variables.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Alertas por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
